---
import { Check } from '@lucide/astro';

interface Props {
  href: string;
  title: string;
  icon: any;
  isActive: boolean;
  trackRead?: boolean;
}

const { href, title, icon: EntryIcon, isActive, trackRead = false } = Astro.props;
---

<a
  href={href}
  class={`block px-2.5 py-1.5 rounded text-sm transition-colors ${
    isActive
      ? 'bg-gold-500/15 text-gold-300 font-medium border-l-2 border-gold-400 shadow-sm shadow-gold-500/10'
      : 'text-slate-300 hover:text-gold-300 hover:bg-slate-850/80'
  }`}
  title={title}
>
  <span class="flex items-center gap-2 min-w-0">
    <EntryIcon class="w-3.5 h-3.5 flex-shrink-0 text-gold-400/80" aria-hidden="true" />
    <span class="truncate min-w-0">{title}</span>
    {trackRead && <Check class="read-tick w-3.5 h-3.5 flex-shrink-0 ml-auto" aria-label="Read" />}
  </span>
</a>
