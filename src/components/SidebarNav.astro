---
import project from '../../project.config.json';
import { getTocData } from '../lib/guideData';
import type { TocEntry } from '../lib/types';
import SidebarEntry from './SidebarEntry.astro';
import {
  BookOpen, Compass, Castle, Scroll, ChevronRight, TrainFront, Trees, House, Landmark, Anchor, Ship,
  Church, Hospital, Mountain, Swords, Sword, Shield, Shirt, Gem, Store, Coins, Ticket, Skull, Users,
  Footprints, Sparkles, Gift, Syringe, Pickaxe, Ghost, Flag, RotateCcw, Cog, Hammer, Map as MapIcon,
  Trophy, FileText, Copyright, ScrollText, Ribbon, Package, Receipt, Dices, HandCoins, Flame, Heart,
  TowerControl, Bug, Tent, DoorOpen, Info, Scale,
  Sunrise, Droplets, TriangleAlert, Network, Columns3, Lock, Target, Crosshair, Worm, CloudRain, Building,
  Zap, ArrowDownToLine, ArrowUpFromLine, Factory, ArrowRightLeft, ArrowDownUp, Magnet, Wind, RotateCw,
  Timer, Square, Radio, Circle, WavesLadder
} from '@lucide/astro';

interface Props {
  currentId?: string;
  isMobileDrawer?: boolean;
}

const { currentId = '', isMobileDrawer = false } = Astro.props;
const isContentsPage = currentId === 'contents';
const tocData = getTocData();
const categories = tocData.guide.overview.sections;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

function getCategoryIcon(name: string) {
  const n = name.toLowerCase();
  if (n.includes('introduction')) return BookOpen;
  return Scroll;
}

// Keyword map: first match on "<code> <title>" wins; falls back to a generic icon.
const ENTRY_ICON_RULES: Array<[RegExp, any]> = [
  [/contents|directory/, MapIcon],
  [/manual|instructions|introduction/, BookOpen],
  [/overview/, Compass],
  [/ending/, Sparkles],
  [/achievement|trophy/, Trophy],
  [/egg|collectible/, Gift],
  [/credits|copyright|disclaimer/, Copyright],
];

// Hand-picked icon per page id (matches the page's theme); keyword rules below are the fallback.
const ENTRY_ICONS_BY_ID: Record<string, any> = {
  'game-overview': Compass,
  awakening: Sunrise,
  'lake-passage': Droplets,
  'bear-traps': TriangleAlert,
  'deathly-rock': Mountain,
  'the-spider': Bug,
  'spiders-lair': Network,
  'interwovened-escape': Network,
  'pillars-of-pain': Columns3,
  'flaming-roll': Flame,
  'unmerciful-village': House,
  'spiders-revenge': Skull,
  'caged-victim': Lock,
  'zombified-bait': Ghost,
  'killer-darts': Target,
  'double-gates': DoorOpen,
  'the-parasite': Worm,
  'rain-machine': CloudRain,
  'in-the-flooding-chambers': WavesLadder,
  'worms-command': Radio,
  rooftops: Building,
  'electric-letters': Zap,
  'down-the-glass': ArrowDownToLine,
  'saw-for-the-zombie': Ghost,
  'upward-elevation': ArrowUpFromLine,
  'impassible-saw': Cog,
  'the-bug': Bug,
  'factory-world': Factory,
  'shifted-industry': Cog,
  'boulder-by-gravity': Circle,
  'dangerous-conveyors': ArrowRightLeft,
  'to-the-perilous-rail': TrainFront,
  'dark-rotation': RotateCcw,
  'machine-guns': Crosshair,
  'gravitational-changes': ArrowDownUp,
  'magnetized-blocks': Magnet,
  'levitated-swing': Wind,
  'side-of-the-world': RotateCw,
  'timed-gravity-changes': Timer,
  'the-final-glass': Square,
  'end-of-the-journey': Flag,
};

function getEntryIcon(id: string, code: string, title: string, categoryIcon: any) {
  if (ENTRY_ICONS_BY_ID[id]) return ENTRY_ICONS_BY_ID[id];
  const hay = `${code} ${title}`.toLowerCase();
  for (const [re, icon] of ENTRY_ICON_RULES) {
    if (re.test(hay)) return icon;
  }
  return categoryIcon;
}

// Nest each run of side-quest entries under the non-side-quest entry that precedes it.
// A side quest with no preceding parent stays top-level (and keeps its badge).
function groupEntries(entries: TocEntry[]): Array<{ entry: TocEntry; children: TocEntry[] }> {
  const groups: Array<{ entry: TocEntry; children: TocEntry[] }> = [];
  for (const entry of entries) {
    const parent = groups[groups.length - 1];
    if (entry.is_sidequest && parent && !parent.entry.is_sidequest) {
      parent.children.push(entry);
    } else {
      groups.push({ entry, children: [] });
    }
  }
  return groups;
}

function getCategoryFullTitle(name: string): string {
  return name;
}
---

<div class={`flex flex-col h-full w-full min-h-0 ${isMobileDrawer ? '' : 'select-none'}`}>
  <!-- Desktop Top Logo Header -->
  {!isMobileDrawer && (
    <div class="sidebar-brand relative px-4 pt-5 pb-6 flex-shrink-0 flex items-center justify-center">
      <a href={`${baseUrl}/`} class="sidebar-brand-link block group w-full" aria-label={`${project.game} Guide Home`}>
        <img
          src={`${baseUrl}/${project.logo}`}
          alt={`${project.game} Guide`}
          class="sidebar-brand-logo w-full h-auto max-h-16 object-contain mx-auto transition-transform duration-200 group-hover:scale-105"
        />
      </a>
      <span class="sidebar-brand-ornament" aria-hidden="true"><i></i></span>
    </div>
  )}

  <!-- Chapters Scroll Area -->
  <div class="flex-1 min-h-0 overflow-y-auto p-3 space-y-3 text-sm text-slate-300 custom-scrollbar overscroll-contain" id={isMobileDrawer ? 'mobile-sidebar-list' : 'sidebar-list'}>
    {categories.map((cat, idx) => {
      const CatIcon = getCategoryIcon(cat.category);
      const hasContentsLink = idx === 0;
      const hasActiveEntry = cat.entries.some((entry) => entry.id === currentId) || (hasContentsLink && isContentsPage);
      // Auto-expand category if it contains the active entry, or expand the first category on home/toc pages
      const isOpenByDefault = hasActiveEntry || (!currentId && idx === 0);

      return (
        <details
          class="sidebar-category group rounded-sm transition-colors"
          open={isOpenByDefault}
          data-category-id={cat.category}
        >
          <summary
            class="list-none flex items-center justify-between cursor-pointer px-2 py-1.5 rounded-sm text-slate-300 hover:text-gold-300 hover:bg-slate-800/50 transition-colors focus:outline-none"
            title={getCategoryFullTitle(cat.category)}
          >
            <div class="flex items-center gap-2 min-w-0">
              <CatIcon class="w-3.5 h-3.5 text-gold-400 flex-shrink-0" />
              <span class="text-xs font-display font-medium uppercase tracking-wider text-slate-200 group-hover:text-gold-300 truncate">
                {cat.category}
              </span>
            </div>
            <ChevronRight class="w-3.5 h-3.5 text-slate-400 transition-transform duration-200 group-open:rotate-90 flex-shrink-0" />
          </summary>

          <ul class="mt-1 space-y-0.5 pl-2.5 border-l border-slate-800/80 ml-3 py-1">
            {hasContentsLink && (
              <li class="sidebar-item" data-active={isContentsPage ? 'true' : undefined}>
                <SidebarEntry
                  href={`${baseUrl}/contents`}
                  title="Contents"
                  icon={MapIcon}
                  isActive={isContentsPage}
                  isAvailable={true}
                />
              </li>
            )}
            {groupEntries(cat.entries).map((group) => {
              const entry = group.entry;
              const isActive = entry.id === currentId;
              const EntryIcon = entry.is_sidequest
                ? Scroll
                : getEntryIcon(entry.id, entry.code, entry.title, CatIcon);
              return (
                <li
                  class="sidebar-item"
                  data-active={isActive ? 'true' : undefined}
                >
                  <SidebarEntry
                    href={`${baseUrl}/guide/${entry.id}`}
                    title={entry.title}
                    icon={EntryIcon}
                    isActive={isActive}
                    isAvailable={!!entry.has_structured}
                    showBadge={entry.is_sidequest}
                  />
                  {group.children.length > 0 && (
                    <ul class="sidebar-children mt-0.5 mb-1 ml-4 pl-2 space-y-0.5 border-l border-slate-800/80">
                      {group.children.map((child) => {
                        const childActive = child.id === currentId;
                        return (
                          <li
                            class="sidebar-item"
                            data-active={childActive ? 'true' : undefined}
                          >
                            <SidebarEntry
                              href={`${baseUrl}/guide/${child.id}`}
                              title={child.title}
                              icon={Scroll}
                              isActive={childActive}
                              isAvailable={!!child.has_structured}
                              isChild
                            />
                          </li>
                        );
                      })}
                    </ul>
                  )}
                </li>
              );
            })}
          </ul>
        </details>
      );
    })}
  </div>
</div>

<script>
  function autoScrollActiveItem(listId: string) {
    const list = document.getElementById(listId);
    if (!list) return;
    const activeItem = list.querySelector('[data-active="true"]');
    if (activeItem) {
      activeItem.scrollIntoView({ block: 'nearest' });
    }
  }

  function initAccordionState(listId: string) {
    const list = document.getElementById(listId);
    if (!list) return;
    const detailsElements = list.querySelectorAll<HTMLDetailsElement>('details.sidebar-category');

    detailsElements.forEach((details) => {
      const catId = details.getAttribute('data-category-id');
      const hasActive = details.querySelector('[data-active="true"]');
      if (hasActive) {
        details.open = true;
      } else if (catId) {
        const stored = sessionStorage.getItem(`sidebar-cat-${catId}`);
        if (stored !== null) {
          details.open = stored === 'true';
        }
      }

      details.addEventListener('toggle', () => {
        if (catId) {
          sessionStorage.setItem(`sidebar-cat-${catId}`, String(details.open));
        }
      });
    });
  }

  initAccordionState('sidebar-list');
  initAccordionState('mobile-sidebar-list');
  autoScrollActiveItem('sidebar-list');
  autoScrollActiveItem('mobile-sidebar-list');
</script>

<style>
  /* Dark scrim, darkest at the top and easing toward the divider, painted over the
     sidebar lattice so the logo reads cleanly. A faint teal halo (the artwork's orb)
     sits on top of the scrim. */
  .sidebar-brand {
    background:
      radial-gradient(ellipse 55% 50% at 50% 45%, rgba(255, 255, 255, 0.10), transparent 75%),
      linear-gradient(180deg, rgba(6, 6, 6, 0.92) 0%, rgba(6, 6, 6, 0.78) 55%, rgba(6, 6, 6, 0.4) 100%);
  }

  /* Dark edge keeps the lettering crisp; the teal bloom stays faint and wide. */
  .sidebar-brand-logo {
    filter:
      drop-shadow(0 1px 1px rgba(0, 0, 0, 0.85))
      drop-shadow(0 0 10px rgba(255, 255, 255, 0.10));
    transition: transform 200ms ease, filter 200ms ease;
  }

  .sidebar-brand-link:hover .sidebar-brand-logo,
  .sidebar-brand-link:focus-visible .sidebar-brand-logo {
    filter:
      drop-shadow(0 1px 1px rgba(0, 0, 0, 0.85))
      drop-shadow(0 0 12px rgba(255, 255, 255, 0.10));
  }

  /* Gold divider: line fading out at both ends with a centre diamond. */
  .sidebar-brand-ornament {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.35) 30%,
      rgba(255, 255, 255, 0.35) 70%,
      transparent 100%
    );
  }

  .sidebar-brand-ornament i {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 29px;
    height: 13px;
    /* Reed / grass silhouette: thin ticks of uneven height rising from the line. */
    background:
      linear-gradient(rgba(255,255,255,0.55), rgba(255,255,255,0.55)) 0 100% / 1px 5px no-repeat,
      linear-gradient(rgba(255,255,255,0.7), rgba(255,255,255,0.7)) 7px 100% / 1px 9px no-repeat,
      linear-gradient(rgba(255,255,255,0.85), rgba(255,255,255,0.85)) 14px 100% / 1px 13px no-repeat,
      linear-gradient(rgba(255,255,255,0.7), rgba(255,255,255,0.7)) 21px 100% / 1px 8px no-repeat,
      linear-gradient(rgba(255,255,255,0.55), rgba(255,255,255,0.55)) 28px 100% / 1px 4px no-repeat;
    transform: translate(-50%, -100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar-brand-logo { transition: none; }
  }
</style>
