---
import { TriangleAlert } from '@lucide/astro';
import { renderInlineMarkup } from '../lib/markup';
import CollapsibleSection from './CollapsibleSection.astro';

interface Props {
  traps?: string[];
}

const { traps = [] } = Astro.props;
---

{traps.length > 0 && (
  <CollapsibleSection id="traps" title="Traps and Obstacles" icon={TriangleAlert} open>
    <div class="card p-5">
      <ul class="space-y-2.5 text-slate-200 text-base">
        {traps.map((trap) => (
          <li class="flex items-start gap-2.5">
            <TriangleAlert class="w-4 h-4 text-gold-400 mt-1 flex-shrink-0" aria-hidden="true" />
            <span class="leading-relaxed"><Fragment set:html={renderInlineMarkup(trap)} /></span>
          </li>
        ))}
      </ul>
    </div>
  </CollapsibleSection>
)}
