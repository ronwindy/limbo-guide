---
import project from '../../project.config.json';
import { Menu, Flame, House, BookOpen, ExternalLink } from '@lucide/astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="mobile-header lg:hidden sticky top-0 z-40 backdrop-blur-md">

  <div class="relative px-4 sm:px-6 h-14 sm:h-16 flex items-center justify-between">
    <!-- Left: Hamburger Drawer Trigger -->
    <button
      id="open-mobile-drawer"
      class="mobile-header__menu p-2 -ml-2 rounded-sm text-slate-200 hover:text-white transition-colors focus:outline-none focus:ring-1 focus:ring-white/60"
      aria-label="Open chapters and navigation menu"
    >
      <Menu class="w-6 h-6" />
    </button>

    <!-- Right: Brand Logo -->
    <a href={`${baseUrl}/`} class="flex items-center group py-1">
      <img
        src={`${baseUrl}/${project.logo}`}
        alt={`${project.game} Guide`}
        class="mobile-header__logo h-10 sm:h-11 w-auto object-contain transition-transform duration-200 group-hover:scale-105"
      />
    </a>
  </div>

  <!-- Divider with centre ornament -->
  <div class="mobile-header__divider" aria-hidden="true"><span></span></div>
</header>

<style>
  .mobile-header {
    position: sticky;
    overflow: hidden;
    /* dark scrim on top (darkest at the top, easing toward the divider) so the logo
       reads cleanly; the violet wash and teal halo stay faintly visible beneath it */
    background:
      linear-gradient(180deg, rgba(6, 6, 6, 0.92) 0%, rgba(6, 6, 6, 0.78) 55%, rgba(6, 6, 6, 0.4) 100%),
      radial-gradient(120% 140% at 100% 50%, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0) 50%),
      radial-gradient(90% 160% at 0% 0%, rgba(255, 255, 255, 0.10) 0%, rgba(255, 255, 255, 0) 60%),
      linear-gradient(180deg, #161616 0%, #0f0f0f 55%, #0a0a0a 100%);
    box-shadow: 0 6px 18px -8px rgba(0, 0, 0, 0.8), inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .mobile-header__logo {
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.6));
  }

  .mobile-header__menu {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.18);
  }
  .mobile-header__menu:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  .mobile-header__divider {
    position: relative;
    height: 2px;
    background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.45) 20%, rgba(255,255,255,0.6) 50%, rgba(255,255,255,0.45) 80%, transparent 100%);
  }
  .mobile-header__divider span {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 7px;
    height: 7px;
    transform: translate(-50%, -50%) rotate(0deg);
    border-radius: 9999px;
    background: #0a0a0a; border: 1px solid #d6d6d6;
    box-shadow: none;
  }
</style>
