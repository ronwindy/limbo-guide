---
import { TriangleAlert, Lightbulb, Info } from '@lucide/astro';
import type { SectionCallout } from '../lib/types';
import { renderBlockMarkup } from '../lib/markup';

interface Props {
  callouts?: SectionCallout[];
}

const { callouts = [] } = Astro.props;

const STYLES = {
  warning: { icon: TriangleAlert, box: 'callout-warning bg-slate-100 border-white text-slate-900 border-2', iconClass: 'text-slate-900', title: 'text-slate-950 uppercase tracking-widest text-sm' },
  tip: { icon: Lightbulb, box: 'bg-white/5 border-white/60 text-slate-100 border', iconClass: 'text-white', title: 'text-white tracking-wider' },
  info: { icon: Info, box: 'bg-transparent border-white/15 border-l-4 border-l-slate-500 text-slate-300', iconClass: 'text-slate-400', title: 'text-slate-200 tracking-wider' },
};
---

{callouts.length > 0 && (
  <div class="space-y-3">
    {callouts.map((c) => {
      const style = STYLES[c.type as keyof typeof STYLES] ?? STYLES.info;
      const Icon = style.icon;
      return (
        <div class={`p-4 rounded-sm text-sm sm:text-base flex gap-3 ${style.box}`}>
          <div class="mt-0.5 flex-shrink-0">
            <Icon class:list={['w-5 h-5', style.iconClass]} aria-hidden="true" />
          </div>
          <div class="space-y-1 flex-1">
            {c.title && <div class={`font-semibold ${style.title}`}>{c.title}</div>}
            <div class="leading-relaxed opacity-95 space-y-2">
              <Fragment set:html={renderBlockMarkup(c.text)} />
            </div>
          </div>
        </div>
      );
    })}
  </div>
)}
