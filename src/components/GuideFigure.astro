---
import type { GuideImage } from '../lib/types';

interface Props {
  image: GuideImage;
}

const { image } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<figure class="guide-figure my-3">
  <img
    src={`${baseUrl}/${image.file}`}
    alt={image.caption}
    loading="lazy"
    decoding="async"
    class="w-full max-w-xl rounded-sm border border-white/15"
  />
  {image.caption && <figcaption class="mt-1.5 text-xs text-slate-400">{image.caption}</figcaption>}
</figure>
