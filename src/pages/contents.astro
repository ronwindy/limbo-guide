---
import BaseLayout from '../layouts/BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import project from '../../project.config.json';
import { getTocData } from '../lib/guideData';

const categories = getTocData().guide.overview.sections ?? [];
---

<BaseLayout title={`Contents — ${project.pageTitleSuffix}`} description={`${project.pageDescriptionPrefix} — Contents`} currentId="contents">
  <article class="max-w-5xl mx-auto space-y-8">
    <header>
      <h1 class="page-title gold-metal-text text-3xl sm:text-4xl lg:text-5xl font-display font-semibold">Contents</h1>
      <div class="page-title-rule" aria-hidden="true"><span></span></div>
    </header>
    <TableOfContents sections={categories} />
  </article>
</BaseLayout>
