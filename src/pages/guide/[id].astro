---
import BaseLayout from '../../layouts/BaseLayout.astro';
import project from '../../../project.config.json';
import { getPages, getPageHtml, getNeighbours, stripInlineStyles, swapOverviewCover, tagChapterLabel, withHeadingIds } from '../../lib/guideData';
import PageToc from '../../components/PageToc.astro';

export function getStaticPaths() {
  return getPages().map((page) => ({ params: { id: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { prev, next } = getNeighbours(page.id);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const { html, headings } = withHeadingIds(
  tagChapterLabel(swapOverviewCover(stripInlineStyles(getPageHtml(page.id)), `${baseUrl}/image-1.png`), page.title),
);
const href = (id: string) => `${baseUrl}/guide/${id}`;
---

<BaseLayout
  title={`${page.title} - ${project.pageTitleSuffix}`}
  description={`${project.pageDescriptionPrefix} - ${page.category}: ${page.title}`}
  currentId={page.id}
  pageSections={headings}
>
  <div class="flex gap-8 items-start">
    <article class="flex-1 min-w-0 max-w-4xl mx-auto space-y-8">
      <header class="text-center">
        <p class="breadcrumb text-xs uppercase tracking-[0.3em] text-slate-400">
          <a href={`${baseUrl}/`} class="hover:text-white">Contents</a> / {page.category}
        </p>
        <h1 class="page-title gold-metal-text text-3xl sm:text-4xl lg:text-5xl font-display font-semibold mt-2">{page.title}</h1>
        <div class="page-title-rule" aria-hidden="true"><span></span></div>
      </header>

      <div class="guide-body" set:html={html} />

      <div class="page-actions">
        <button type="button" class="mark-read" data-mark-read={page.id} data-page={page.id} aria-pressed="false">Mark as read</button>
      </div>

      <div class="page-title-rule page-end-rule" aria-hidden="true"><span></span></div>

      <nav class="page-nav grid gap-3 sm:grid-cols-2" aria-label="Previous and next">
        {prev ? <a class="card px-4 py-3 text-slate-200 hover:text-white hover:border-white/30" href={href(prev.id)}>&larr; {prev.title}</a> : <span></span>}
        {next ? <a class="card px-4 py-3 text-right text-slate-200 hover:text-white hover:border-white/30" href={href(next.id)}>{next.title} &rarr;</a> : <span></span>}
      </nav>
    </article>
    {headings.length > 1 && (
      <aside class="hidden xl:block w-64 flex-shrink-0 sticky top-6 max-h-[calc(100vh-3rem)] overflow-y-auto custom-scrollbar">
        <PageToc sections={headings} />
      </aside>
    )}
  </div>
</BaseLayout>
