---
import BaseLayout from '../layouts/BaseLayout.astro';
import project from '../../project.config.json';
import { getTocData, getAllStructuredSections } from '../lib/guideData';
import { ArrowRight, Play, ListChecks, Lock } from '@lucide/astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const structured = new Map(getAllStructuredSections().map((s) => [s.id, s.data.guide]));
const categories = getTocData().guide.overview.sections ?? [];

// Chapters in order; those with a structured page are playable, the rest are "coming soon".
const chapters = categories
  .filter((c: any) => c.category === 'Chapters')
  .flatMap((c: any) => c.entries)
  .map((e: any, i: number) => {
    const g: any = structured.get(e.id);
    return {
      id: e.id,
      n: i + 1,
      title: e.title,
      ready: !!e.has_structured,
      image: g?.images?.find((im: any) => /cover/i.test(im.caption ?? ''))?.file ?? null,
      steps: (g?.steps ?? []).map((s: any) => s.step_number || s.id)
    };
  });

const ready = chapters.filter((c) => c.ready);
const first = ready[0];
const overview = structured.has('game-overview');
---

<BaseLayout currentId="" showSidebar={false} isWide={true}>
  <!-- HERO -->
  <section class="hero relative -mx-4 sm:-mx-6 lg:-mx-8 -mt-4 sm:-mt-6 lg:-mt-8 min-h-[88vh] flex items-center justify-center overflow-hidden">
    <div class="hero-bg absolute inset-0" style={`background-image: url(${baseUrl}/background.png)`} aria-hidden="true"></div>
    <div class="hero-fade absolute inset-0" aria-hidden="true"></div>
    <div class="hero-reeds absolute inset-x-0 bottom-0" aria-hidden="true"></div>

    <div class="relative z-10 max-w-3xl px-6 text-center space-y-6">
      <p class="hero-eyebrow text-xs sm:text-sm tracking-[0.5em] uppercase text-slate-400">A walkthrough companion</p>
      <h1 class="hero-title gold-metal-text font-display font-semibold text-6xl sm:text-8xl">{project.game}</h1>
      <div class="page-title-rule mx-auto" aria-hidden="true"><span></span></div>
      <p class="hero-tag text-slate-300 text-lg sm:text-xl max-w-xl mx-auto">
        Every chapter, step by step: a video to watch, a checklist to tick, and your place saved as you go.
      </p>
      <div class="hero-cta flex flex-wrap justify-center gap-3 pt-2">
        <a id="continue-btn" href={first ? `${baseUrl}/guide/${first.id}` : `${baseUrl}/contents`} class="inline-flex items-center gap-2 px-7 py-3 rounded-sm bg-gold-500 hover:bg-gold-400 text-slate-950 font-semibold transition-colors">
          <Play class="w-4 h-4" aria-hidden="true" />
          <span id="continue-label">{first ? `Begin: ${first.title}` : 'Contents'}</span>
        </a>
        <a href={`${baseUrl}/contents`} class="inline-flex items-center gap-2 px-7 py-3 rounded-sm border border-white/25 hover:border-white/60 text-slate-200 transition-colors">
          <ListChecks class="w-4 h-4" aria-hidden="true" /> Contents
        </a>
      </div>
      <p id="progress-line" class="text-sm text-slate-400 hidden"></p>
    </div>

    <a href="#chapters" class="scroll-cue absolute bottom-6 left-1/2 -translate-x-1/2 z-10 text-slate-400 hover:text-white text-xs tracking-[0.4em] uppercase" aria-label="Scroll to chapters">
      Descend
      <span class="block mx-auto mt-2 w-px h-8 bg-gradient-to-b from-white/60 to-transparent"></span>
    </a>
  </section>

  <!-- CHAPTERS -->
  <section id="chapters" class="max-w-6xl mx-auto py-16 space-y-8 scroll-mt-4">
    <header class="space-y-2">
      <h2 class="font-display text-2xl sm:text-3xl gold-metal-lite">Chapters</h2>
      <p class="text-slate-400">
        {ready.length} of {chapters.length} chapters are ready.
        {overview && <a class="underline decoration-white/30 hover:decoration-white" href={`${baseUrl}/guide/game-overview`}>Read the game overview</a>}
      </p>
    </header>

    <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {chapters.map((c) => (
        <li>
          {c.ready ? (
            <a href={`${baseUrl}/guide/${c.id}`} class="chapter-card group block h-full rounded-sm border border-white/15 hover:border-white/50 bg-black/50 overflow-hidden transition-colors" data-chapter={c.id} data-steps={c.steps.join(',')}>
              <div class="aspect-video bg-black/60 overflow-hidden">
                {c.image && <img src={`${baseUrl}/${c.image}`} alt="" loading="lazy" decoding="async" class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition duration-700" />}
              </div>
              <div class="p-4 space-y-2">
                <p class="text-xs tracking-[0.3em] uppercase text-slate-500">Chapter {c.n}</p>
                <h3 class="text-lg text-slate-100">{c.title}</h3>
                <div class="h-px bg-white/10"><div class="chapter-bar h-px bg-white/80 w-0 transition-all"></div></div>
                <p class="chapter-count text-xs text-slate-400">{c.steps.length} steps</p>
              </div>
            </a>
          ) : (
            <div class="h-full rounded-sm border border-white/10 bg-black/30 p-4 flex flex-col justify-end min-h-[8rem] opacity-60">
              <p class="text-xs tracking-[0.3em] uppercase text-slate-500">Chapter {c.n}</p>
              <h3 class="text-base text-slate-300">{c.title}</h3>
              <p class="mt-1 text-xs text-slate-500 inline-flex items-center gap-1"><Lock class="w-3 h-3" aria-hidden="true" /> Coming soon</p>
            </div>
          )}
        </li>
      ))}
    </ol>
  </section>

  <!-- EXTRA RESEARCH -->
  <section class="max-w-3xl mx-auto pb-20">
    <div class="rounded-sm border border-dashed border-white/25 bg-black/40 p-6 space-y-3">
      <p class="text-xs tracking-[0.3em] uppercase text-slate-400">Extra research · not from the walkthrough source</p>
      <h2 class="font-display text-xl text-slate-100">About the game</h2>
      <ul class="list-disc pl-5 space-y-1.5 text-slate-300">
        <li>Limbo is a puzzle-platformer developed by Playdead, a studio based in Denmark.</li>
        <li>It was first released in 2010, on Xbox Live Arcade.</li>
        <li>It was a 2010 Independent Games Festival finalist in Technical Excellence and Excellence in Visual Art.</li>
      </ul>
      <p class="text-xs text-slate-500">
        Sources:
        <a class="underline" href="https://gamedeveloper.com/game-platforms/igf-finalist-i-limbo-i-heading-to-xbla">Game Developer: IGF finalist, heading to XBLA</a>.
        Game facts in the chapters themselves come only from the wiki walkthrough.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-bg {
    background-size: cover;
    background-position: 40% center;
    filter: grayscale(1) brightness(0.65);
    transform: scale(1.08);
    animation: hero-drift 40s ease-in-out infinite alternate;
  }
  .hero-fade {
    background:
      radial-gradient(ellipse at center, rgba(0, 0, 0, 0.15) 0%, rgba(0, 0, 0, 0.75) 100%),
      linear-gradient(to bottom, rgba(10, 10, 10, 0) 60%, #0a0a0a 100%);
  }
  .hero-reeds {
    height: 90px;
    background:
      repeating-linear-gradient(90deg, #000 0 1px, transparent 1px 11px) bottom / 100% 40% no-repeat,
      repeating-linear-gradient(90deg, #000 0 2px, transparent 2px 23px) bottom / 100% 70% no-repeat,
      repeating-linear-gradient(90deg, #000 0 1px, transparent 1px 37px) bottom / 100% 100% no-repeat;
    opacity: 0.7;
  }
  .hero-eyebrow, .hero-title, .hero-tag, .hero-cta { opacity: 0; animation: hero-in 1.6s ease forwards; }
  .hero-title { animation-delay: 0.5s; }
  .hero-tag { animation-delay: 1.2s; }
  .hero-cta { animation-delay: 1.8s; }
  .scroll-cue { animation: cue 3s ease-in-out infinite; }
  @keyframes hero-drift { to { transform: scale(1.18) translateX(-2%); } }
  @keyframes hero-in { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  @keyframes cue { 50% { opacity: 0.4; } }
  @media (prefers-reduced-motion: reduce) {
    .hero-bg, .scroll-cue { animation: none; }
    .hero-eyebrow, .hero-title, .hero-tag, .hero-cta { animation: none; opacity: 1; }
  }
</style>

<script>
  // Read tick progress written by StepChecklist (key: sh-step-<id>-<step>).
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.chapter-card'));
  let done = 0;
  let total = 0;
  let resume: HTMLElement | null = null;
  try {
    for (const card of cards) {
      const id = card.dataset.chapter!;
      const steps = (card.dataset.steps ?? '').split(',').filter(Boolean);
      const ticked = steps.filter((s) => localStorage.getItem(`sh-step-${id}-${s}`) === 'true').length;
      done += ticked;
      total += steps.length;
      const bar = card.querySelector<HTMLElement>('.chapter-bar');
      if (bar && steps.length) bar.style.width = `${(ticked / steps.length) * 100}%`;
      const count = card.querySelector<HTMLElement>('.chapter-count');
      if (count) count.textContent = ticked === steps.length ? 'Complete' : `${ticked} / ${steps.length} steps`;
      if (!resume && ticked < steps.length) resume = card;
    }
  } catch {}
  if (done > 0 && resume) {
    const btn = document.getElementById('continue-btn') as HTMLAnchorElement | null;
    const label = document.getElementById('continue-label');
    const link = resume as HTMLAnchorElement;
    if (btn) btn.href = link.href;
    if (label) label.textContent = `Continue: ${resume.querySelector('h3')?.textContent ?? ''}`;
  }
  if (done > 0) {
    const line = document.getElementById('progress-line');
    if (line) {
      line.textContent = `${done} of ${total} steps ticked`;
      line.classList.remove('hidden');
    }
  }
</script>
