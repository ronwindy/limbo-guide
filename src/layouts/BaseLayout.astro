---
import Navigation from '../components/Navigation.astro';
import MobileNavDrawer from '../components/MobileNavDrawer.astro';
import SidebarNav from '../components/SidebarNav.astro';
import '../styles/global.css';
import project from '../../project.config.json';

interface Props {
  title?: string;
  description?: string;
  currentId?: string;
  pageSections?: Array<{ id: string; label: string; count?: number }>;
  isWide?: boolean;
  showSidebar?: boolean;
}

const {
  title = project.defaultTitle,
  description = project.defaultDescription,
  currentId = "",
  pageSections = [],
  isWide = true,
  showSidebar = true
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@200;300;400;600&family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=Jost:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500;1,600;1,700;1,800&display=swap" rel="stylesheet">
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      // Apply saved sidebar state before first paint (no flash). Default: collapsed below 1280px.
      (function () {
        var state = null;
        try { state = localStorage.getItem('sidebar-state'); } catch (e) {}
        if (state !== 'open' && state !== 'collapsed') {
          state = window.innerWidth < 1280 ? 'collapsed' : 'open';
        }
        document.documentElement.setAttribute('data-sidebar', state);
      })();
    </script>
    <style is:global>
      .sidebar-aside {
        transition: width 0.25s ease;
      }
      html[data-sidebar='collapsed'] .sidebar-aside {
        width: 0;
        border-right-width: 0;
      }
      .sidebar-toggle {
        position: absolute;
        top: 50%;
        left: 100%;
        transform: translateY(-50%);
        width: 20px;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #bdbdbd;
        background: rgba(8, 8, 8, 0.92);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-left: 0;
        border-radius: 0 2px 2px 0;
        cursor: pointer;
        transition: color 0.15s ease, background-color 0.15s ease;
      }
      .sidebar-toggle:hover,
      .sidebar-toggle:focus-visible {
        color: #ffffff;
        background: rgba(24, 24, 24, 0.98);
      }
      .sidebar-toggle svg {
        transition: transform 0.25s ease;
      }
      html[data-sidebar='collapsed'] .sidebar-toggle svg {
        transform: rotate(180deg);
      }
      @media (prefers-reduced-motion: reduce) {
        .sidebar-aside,
        .sidebar-toggle svg {
          transition: none;
        }
      }
    </style>
  </head>
  <body class="bg-void text-slate-100 flex flex-col min-h-screen relative selection:bg-white/25 selection:text-white">
    <!-- Fixed Site Background -->
    <div class="fixed inset-0 pointer-events-none -z-10 overflow-hidden" aria-hidden="true">
      <div class="absolute inset-0 limbo-bg" style={`background-image: url(${baseUrl}/background.png)`}></div>
      <div class="absolute inset-0 limbo-fog"></div>
      <div class="absolute inset-0 limbo-grain"></div>
      <div class="absolute inset-0 limbo-vignette"></div>
    </div>


    <Navigation />
    <MobileNavDrawer currentId={currentId} pageSections={pageSections} />

    <div class="flex-grow flex min-h-screen w-full relative">
      {showSidebar && (
        <div class="sidebar-shell hidden lg:block flex-shrink-0 sticky top-0 h-screen z-30">
          <aside id="desktop-sidebar" class="sidebar-aside h-full lg:w-72 xl:w-80 glass-sidebar relative border-r border-slate-800/80 overflow-hidden">
            <div class="flex flex-col h-full w-72 xl:w-80">
              <SidebarNav currentId={currentId} />
            </div>
          </aside>
          <button
            type="button"
            id="sidebar-toggle"
            class="sidebar-toggle"
            aria-controls="desktop-sidebar"
            aria-expanded="true"
            aria-label="Hide chapter sidebar"
            title="Hide/show sidebar"
          >
            <svg viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12.5 4.5 7 10l5.5 5.5" />
            </svg>
          </button>
        </div>
      )}
      <div class="flex-1 min-w-0 flex flex-col justify-between">
        <main class={`flex-grow w-full mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6 lg:py-8 ${isWide ? 'max-w-[1440px]' : 'max-w-5xl'}`}>
          <slot />
        </main>
      </div>
    </div>

    <script is:inline>
      (function () {
        var btn = document.getElementById('sidebar-toggle');
        var aside = document.getElementById('desktop-sidebar');
        if (!btn || !aside) return;
        var root = document.documentElement;
        function sync() {
          var collapsed = root.getAttribute('data-sidebar') === 'collapsed';
          btn.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
          btn.setAttribute('aria-label', collapsed ? 'Show chapter sidebar' : 'Hide chapter sidebar');
          if (collapsed) aside.setAttribute('inert', ''); else aside.removeAttribute('inert');
        }
        btn.addEventListener('click', function () {
          var next = root.getAttribute('data-sidebar') === 'collapsed' ? 'open' : 'collapsed';
          root.setAttribute('data-sidebar', next);
          try { localStorage.setItem('sidebar-state', next); } catch (e) {}
          sync();
        });
        sync();
      })();
    </script>

    <!-- Controller hints: shown only once a gamepad is detected (see src/lib/gamepad.ts) -->
    <div id="gamepad-hints" class="hidden fixed bottom-3 left-1/2 -translate-x-1/2 z-40 max-w-[94vw]" role="status" aria-live="polite">
      <div class="flex items-center gap-x-3 gap-y-1.5 flex-wrap rounded-sm border border-white/20 bg-obsidian/95 backdrop-blur px-4 py-2 text-xs sm:text-sm text-slate-300 shadow-lg">
        <span><kbd class="gp-key">A</kbd> Tick</span>
        <span><kbd class="gp-key">B</kbd> Back</span>
        <span><kbd class="gp-key">X</kbd> Contents</span>
        <span><kbd class="gp-key">Y</kbd> Next unticked</span>
        <span><kbd class="gp-key">LB</kbd><kbd class="gp-key">RB</kbd> Back / forward</span>
        <span><kbd class="gp-key">LT</kbd><kbd class="gp-key">RT</kbd> Prev / next section</span>
        <span><kbd class="gp-key">D-pad</kbd> Move</span>
        <span><kbd class="gp-key">L-stick</kbd> Scroll · <kbd class="gp-key">R-stick</kbd> Fast</span>
        <span><kbd class="gp-key">Start</kbd> Menu</span>
        <span><kbd class="gp-key">View</kbd> Top</span>
        <span><kbd class="gp-key">R3</kbd> Fullscreen</span>
        <button id="gamepad-hints-dismiss" type="button" class="ml-1 px-2 py-0.5 rounded border border-slate-700 text-slate-400 hover:text-white hover:border-white/50" aria-label="Hide controller hints">Hide</button>
      </div>
    </div>

    <script>
      import '../lib/gamepad';
    </script>
  </body>
</html>

